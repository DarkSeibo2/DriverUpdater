<Window x:Class="DriverUpdater.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Update Sources" Style="{StaticResource SectionHeader}" />
            <ItemsControl ItemsSource="{Binding SourceConfigs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  ToolTip="{Binding Description}"
                                  Style="{StaticResource Row}"
                                  Margin="0,3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Installation" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Create restore point before installing drivers" IsChecked="{Binding CreateRestorePoint}" Style="{StaticResource Row}" />
            <CheckBox Content="Backup current drivers before installing" IsChecked="{Binding BackupDrivers}" Style="{StaticResource Row}" />
            <CheckBox Content="Check certificate revocation (slower, needs network)"
                      IsChecked="{Binding VerifyRevocation}"
                      ToolTip="Verifies CRL/OCSP for driver signatures. Can fail on isolated networks."
                      Style="{StaticResource Row}" />

            <TextBlock Text="Exclusions" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Excluded device classes (comma-separated):" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                     Text="{Binding ExcludedClasses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g., USB, HIDClass" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" Width="90" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
                <Button Content="Cancel" Width="90"
                        Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
            </StackPanel>
    </StackPanel>
</Window>
